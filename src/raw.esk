struct _OrtFGetApi { fn()->**void f; }
struct _OrtFGetVersion { fn()->string f; }

**void _ort_api_table;

// The ONNX Runtime version string of the loaded library, such as "1.31".
string ort_version_string() {
    *OrtApiBase base = OrtGetApiBase();
    _OrtRaw r = _OrtRaw{base.GetVersionString, null};
    fn()->string f = ((*_OrtFGetVersion)&r).f;
    return f();
}

// OrtApiBase::GetApi(version): the function table, or null when unsupported.
**void ort_get_api(uint32 version) {
    *OrtApiBase base = OrtGetApiBase();
    _OrtRaw r = _OrtRaw{base.GetApi, (*void)(uint64)version};
    fn()->**void f = ((*_OrtFGetApi)&r).f;
    return f();
}

// The OrtApi table for ORT_API_VERSION, fetched once; null if the library is older.
**void ort_api() {
    if (_ort_api_table == null) _ort_api_table = ort_get_api(ORT_API_VERSION);
    return _ort_api_table;
}

