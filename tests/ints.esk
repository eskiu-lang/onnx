import <io>;
import <mem>;
import <onnx>;

// int64, int32 and uint8 tensors: ids -> ids * 3 + 1 (int64) and Cast(ids) (int32);
// pix (uint8) -> pix / 255 (float).

Result<int, string> run() {
    OnnxSession s = onnx_session("tests/data/ints.onnx", null)?;
    defer s.release();
    if (s.input(0).type != ONNX_INT64 || s.input(1).type != ONNX_UINT8) return Err<int, string>("input types");
    if (s.output(1).type != ONNX_INT32) return Err<int, string>("output type");
    if (s.input(0).shape.size != 1 || s.input(0).shape.data[0] != -1) return Err<int, string>("dynamic dim");
    int64[5] ids = {0, 1, -2, 40000000000, 7};
    int64[1] ids_shape = {5};
    OnnxTensor a = onnx_tensor_i64(&ids[0], &ids_shape[0], 1)?;
    defer a.release();
    uint8[4] pix = {0, 51, 128, 255};
    int64[1] pix_shape = {4};
    OnnxTensor b = onnx_tensor_u8(&pix[0], &pix_shape[0], 1)?;
    defer b.release();
    string[2] names = {"ids", "pix"};
    OnnxTensor[2] inputs = {a, b};
    List<OnnxTensor> out = s.run(&names[0], &inputs[0], 2, null, 0)?;
    defer onnx_tensors_free(&out);
    if (out.size != 3) return Err<int, string>("output count");
    *int64 y = out.data[0].i64();
    *int n = out.data[1].i32();
    *float f = out.data[2].f32();
    if (y == null || n == null || f == null) return Err<int, string>("output types");
    for (i in 0..5) {
        if (y[i] != ids[i] * 3 + 1) return Err<int, string>("int64 values");
        if (n[i] != (int)ids[i]) return Err<int, string>("int32 values");
    }
    for (i in 0..4) {
        float d = f[i] - (float)pix[i] / 255.0;
        if (d > 0.000001 || d < -0.000001) return Err<int, string>("uint8 values");
    }
    if (out.data[0].at(3) != 120000000001.0) return Err<int, string>("at");
    if (out.data[0].argmax() != 3) return Err<int, string>("argmax");
    return Ok<int, string>(0);
}

int main() {
    Result<int, string> r = run();
    if (!r.ok) {
        printf("FAIL: %s\n", r.error);
        return 1;
    }
    return 0;
}
