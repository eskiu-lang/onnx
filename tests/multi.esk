import <io>;
import <mem>;
import <onnx>;

// Two inputs and three outputs: inputs given in any order, outputs chosen by name.

Result<int, string> run() {
    OnnxSession s = onnx_session("tests/data/multi.onnx", null)?;
    defer s.release();
    if (s.input_count() != 2 || s.output_count() != 3) return Err<int, string>("counts");
    if (s.input_index("b") != 1 || s.output_index("neg") != 2 || s.output_index("nope") != -1) return Err<int, string>("index");
    float[4] a = {1.0, 2.0, 3.0, 4.0};
    float[4] b = {5.0, 6.0, 7.0, 8.0};
    int64[2] shape = {2, 2};
    OnnxTensor ta = onnx_tensor_f32(&a[0], &shape[0], 2)?;
    defer ta.release();
    OnnxTensor tb = onnx_tensor_f32(&b[0], &shape[0], 2)?;
    defer tb.release();
    string[2] names = {"b", "a"};
    OnnxTensor[2] inputs = {tb, ta};
    string[2] wanted = {"prod", "sum"};
    List<OnnxTensor> out = s.run(&names[0], &inputs[0], 2, &wanted[0], 2)?;
    defer onnx_tensors_free(&out);
    if (out.size != 2) return Err<int, string>("output count");
    *float prod = out.data[0].f32();
    *float sum = out.data[1].f32();
    float[4] want_prod = {19.0, 22.0, 43.0, 50.0};
    for (i in 0..4) {
        if (sum[i] != a[i] + b[i]) return Err<int, string>("sum");
        if (prod[i] != want_prod[i]) return Err<int, string>("prod");
    }
    List<OnnxTensor> all = s.run(&names[0], &inputs[0], 2, null, 0)?;
    defer onnx_tensors_free(&all);
    if (all.size != 3 || all.data[2].f32()[3] != -4.0) return Err<int, string>("all outputs");
    return Ok<int, string>(0);
}

int main() {
    Result<int, string> r = run();
    if (!r.ok) {
        printf("FAIL: %s\n", r.error);
        return 1;
    }
    return 0;
}
